# Frontend settings: copy to .env.local (git-ignored). These are public and end up in the browser.
VITE_API_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=589389699921-ol224oo6m4svf9tts3enahorubm4lb1s.apps.googleusercontent.com
# Shows the development login next to Google sign-in. Never put the shared password in an env file.
VITE_DEV_LOGIN=true
# Enable the expanded buddy chooser after applying the backend buddy migration.
# Existing saved selections remain readable when the chooser is disabled.
VITE_BUDDY_CATALOG_ENABLED=false
