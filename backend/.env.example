# Copy to .env or use scripts/bootstrap_local.py. Never commit .env.
DATABASE_URL=postgresql://hq_dev@127.0.0.1:55432/habitquest
TEST_DATABASE_URL=postgresql://hq_dev@127.0.0.1:55432/habitquest_test
JWT_SECRET=<a long random string>
JWT_ISSUER=http://127.0.0.1:8000
# Google sign-in: the OAuth web client id (public; it appears in the frontend too).
GOOGLE_CLIENT_ID=589389699921-ol224oo6m4svf9tts3enahorubm4lb1s.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:5180
# Every AI feature: fake (keyword stand-in) or openai (any OpenAI-compatible endpoint). To switch provider, change
# only these lines. OPENAI_MODEL is "large", OPENAI_SMALL_MODEL "small", OPENAI_SAFETY_MODEL "safety" (optional).
AI_MODE=fake
# Buddy catalog is deterministic and uses existing public artwork. Disable only new catalog writes
# for rollback; saved selections and the original four buddies remain readable.
BUDDY_CATALOG_ENABLED=true
# Planner/review reasoning only; keeps OPENAI_MODEL and its provider unchanged.
# auto = none for Nebius DeepSeek V4/V4.1, provider default for other models.
# Explicit none/low/medium/high is available when supported by the configured model.
AI_HELPER_REASONING_EFFORT=auto
# Groq (fastest; free tier has low tokens-per-minute limits):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_SMALL_MODEL=openai/gpt-oss-20b
# OPENAI_SAFETY_MODEL=openai/gpt-oss-safeguard-20b
# Nebius Token Factory:
# OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_SMALL_MODEL=openai/gpt-oss-20b
# OPENAI_SAFETY_MODEL=
# OPENAI_API_KEY=<secret>
# The habit coach: refined (one generator + generated-text Safety), or legacy agent/crew.
COACH_ENGINE=refined
# Optional per-agent overrides, role:size:effort, comma-separated. Roles: triage, research, progress, planner, fit,
# safety. Sizes: large, small, safety. Efforts: low, medium, high. E.g. CREW_ROLES=planner:large:low
CREW_ROLES=
# CREW_ROLES applies only to the legacy crew. Refined routing is explicit below.

# REFINED COACH: start with legacy to keep the existing provider as a baseline.
# To carry the planning agent's OpenAI Luna into Coach, set COACH_PROVIDER=planning
# and populate PLANNING_OPENAI_API_KEY. This NEVER changes child screens/reports.
COACH_PROVIDER=legacy
COACH_MODEL=gpt-6-luna
COACH_API_MODE=responses
COACH_REASONING_EFFORT=low
COACH_MAX_OUTPUT_TOKENS=1600
COACH_REQUEST_TIMEOUT_SECONDS=30
COACH_MAX_RETRIES=1
COACH_TIMEOUT_SECONDS=65
COACH_CONTEXT_TTL_SECONDS=30
COACH_CONTEXT_MAX_ENTRIES=128
# Output Safety reviews new Coach prose only on existing OPENAI_BASE_URL / OPENAI_API_KEY.
# PARENT_RISK_MODEL remains for legacy workflows, not refined Coach or habit generation.
# Bounded habit generation uses local validation and parent approval, no separate Safety model.
# Blank preserves OPENAI_SAFETY_MODEL -> OPENAI_SMALL_MODEL -> OPENAI_MODEL.
# To pin today's local routing explicitly, use deepseek-ai/DeepSeek-V4.1-Flash-1017.
PARENT_RISK_MODEL=
OUTPUT_SAFETY_MODEL=

# IMPORTED PLANNING OPENAI GROUP: Coach, habit writing and query embeddings.
# Copy the planning-agent/.env OPENAI_API_KEY value into this NEW variable locally.
# Do not overwrite this app's OPENAI_API_KEY (it may serve Nebius or another provider).
# Keep actual keys in ignored .env or deployment secrets, never VITE_* / frontend.
PLANNING_OPENAI_BASE_URL=https://api.openai.com/v1
PLANNING_OPENAI_API_KEY=

# EXPLICIT GENERATED HABITS: leave disabled until the draft/approval feature is installed.
# Uses the imported OpenAI group above, independently of COACH_PROVIDER.
HABIT_GENERATION_ENABLED=false
HABIT_GENERATION_MODEL=gpt-6-luna
HABIT_GENERATION_API_MODE=responses
HABIT_GENERATION_REASONING_EFFORT=low
HABIT_GENERATION_TIMEOUT_SECONDS=45
HABIT_GENERATION_MAX_RETRIES=0
# Base floor; the writer reserves max(floor, 800 + 1100 * requested_count).
HABIT_GENERATION_TOKEN_FLOOR=2800
# Evaluation payload capture is not implemented; raw prompt/response capture stays off.
# Both imported Responses clients set store=False. Do not import the prototype's
# PLANNER_MAX_MODEL_CALLS=5 tool loop: refined generation has its own revision cap.

# RETRIEVAL: local/fixture/disabled need no Pinecone credentials. Live pinecone
# requires AI_MODE=openai and the imported OpenAI credentials for embeddings.
RETRIEVAL_MODE=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=0
# Copy exact key + host from planning-agent/.env. Host excludes https://.
# Existing index is read only: these settings never create/populate one.
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX_NAME=hq-habits-v1
PINECONE_NAMESPACE=habits-0-1-0
PINECONE_API_VERSION=2026-07
PINECONE_METRIC=cosine
PINECONE_VECTOR_FIELD=embedding
PINECONE_TIMEOUT_SECONDS=15
# Setup metadata only (not runtime creation/region selectors): aws / us-east-1.
CATALOG_VERSION=0.1.0
# Pinned canonical catalog is packaged in this repository; leave overrides empty.
# This reference artifact does not preload database goals. Only goals selected by
# reviewed Coach generation are saved locally; browsing/retrieval remain read-only.
CATALOG_SNAPSHOT_POINTER=
# Empty = system trust. On the current Mac, an explicit path is /etc/ssl/cert.pem.
# Never disable verification to work around a provider certificate error.
SSL_CERT_FILE=

# Historical planning utilities; these values no longer configure app admission.
# Tokenomics stores versioned rates and policy in PostgreSQL, edited only at /admin.
# Keep old reservations for migration carryover; never reset a spent allowance.
# These fallback estimates came from the prototype and are not new verified prices.
PLANNING_TEST_BUDGET_USD=1.00
PLANNING_INPUT_RATE_PER_MILLION=0.10
PLANNING_OUTPUT_RATE_PER_MILLION=0.50
# Main auth/history replaces PLANNER_SESSION_TTL_SECONDS / PLANNER_MAX_SESSIONS.
# Neither fixture mode nor these accounting values authorize paid live testing.
# Development login from /docs (needs JWT_SECRET).
DEV_LOGIN=true
DEV_LOGIN_PASSWORD=<12+ characters>

# Redacted coach traces in LangSmith, off by default. Do not use LANGSMITH_TRACING: it sends everything unredacted,
# so the app switches it off. TRACE_SAMPLE is the share of ordinary turns that keep their redacted text.
TRACE_COACH=false
TRACE_SAMPLE=0.1
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=habitquest
# EU accounts: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Legacy imported-provider utilities only. Tokenomics now controls app admission
# through /admin and defaults to tracking-only. The migration preserves this old
# ledger as carryover; never reset it. Paid benchmarks need an independent approved cap.
PLANNING_BUDGET_ENABLED=true
# Separate operator login at /admin. Never use a VITE_* variable for these secrets.
# Generate independent random 32-byte URL-safe values; do not reuse JWT_SECRET.
# ADMIN_ENABLED=false is safe until both private values are provisioned in .env.
ADMIN_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_MINUTES=30
ADMIN_SIGN_IN_LIMIT=5
# Increment when rotating the password to revoke earlier admin sessions.
ADMIN_AUTH_VERSION=1

# AWS ALB deployment only: JSON list of the ALB's subnet CIDRs. Local default [].
# Run uvicorn with --no-proxy-headers; ALB XFF mode must be append with client
# ports disabled. Task ingress MUST allow only the matching ALB security group.
# Only the last appended IP from a trusted socket peer is used for sign-in limits.
# ALB_TRUSTED_PROXY_CIDRS=["172.31.96.0/24","172.31.97.0/24"]
